# ── required ──────────────────────────────────────────────
# Supabase Postgres — use the Supavisor pooler URL (port 6543)
# Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgres://postgres.xxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ── storage mode ──────────────────────────────────────────
# PG_ONLY=true runs ALL live state on Postgres (pool, bottles, pickup,
# nonces, pop tokens) and never connects to Redis. Temporary mode while
# Redis consistency is being validated. Remove/unset to use Redis as the
# hot store with Postgres as archive. docker-compose.prod.yml sets it.
# PG_ONLY=true

# Optional read-through cache in front of Postgres (PG_ONLY mode only).
# Redis is NEVER authoritative: every value is populated from PG and every
# Redis error falls back to Postgres. If Redis is down at boot or
# unreachable, the API runs PG-only with zero behavior change.
# REDIS_CACHE=true
# REDIS_URL=redis://redis:6379/0   (docker-compose service name)

# ── optional tuning ───────────────────────────────────────
# ADDR=:8080
# POOL_TTL_HOURS=24
# BOTTLE_TTL_HOURS=168
# MAX_POOL_KEYS=10000
# MAX_ACTIVE_BOTTLES=500

# Protects GET /api/metrics — send the same value as X-Metrics-Token.
# Generate with: openssl rand -hex 24
METRICS_TOKEN=

# Optional: Sentry error reporting (backend panics). Empty = disabled.
# SENTRY_DSN=

# ── billing (Polar.sh) — paywall after free trial ───────
# TRIAL_DAYS=15
# TRIAL_EXTENSIONS=1
# TRIAL_EXTENSION_DAYS=15
# POLAR_ACCESS_TOKEN=
# POLAR_API_BASE=https://api.polar.sh
# POLAR_PRODUCT_MONTHLY=
# POLAR_PRODUCT_YEARLY=
# POLAR_WEBHOOK_SECRET=
# WEB_URL=https://web.a09f.com
