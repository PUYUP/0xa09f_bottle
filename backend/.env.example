ADDR=:8080
REDIS_URL=redis://localhost:6379/0
# Optional Postgres/Supabase archive for bottles (leave empty to disable)
# DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:5432/postgres
POOL_TTL_HOURS=24
BOTTLE_TTL_HOURS=168
MAX_POOL_KEYS=10000
MAX_ACTIVE_BOTTLES=500
# Optional: protects GET /api/metrics (send as X-Metrics-Token header).
# Leave empty for open access (local dev only — set it in production).
# METRICS_TOKEN=change-me
# Optional: Sentry DSN for backend error reporting. Empty = disabled.
# SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0

# ── billing (Polar.sh) ─────────────────────────────────
# Free trial per identity: TRIAL_DAYS once + TRIAL_EXTENSIONS extensions
# of TRIAL_EXTENSION_DAYS each, then paywall.
# TRIAL_DAYS=15
# TRIAL_EXTENSIONS=1
# TRIAL_EXTENSION_DAYS=15
# POLAR_ACCESS_TOKEN=polar_oat_xxx
# POLAR_API_BASE=https://api.polar.sh        # sandbox: https://sandbox-api.polar.sh
# POLAR_PRODUCT_MONTHLY=prod_xxx             # $2/mo product id
# POLAR_PRODUCT_YEARLY=prod_yyy              # $10/yr product id
# POLAR_WEBHOOK_SECRET=whsec_xxx             # from Polar webhook settings
# WEB_URL=https://web.a09f.com               # checkout success/return base
