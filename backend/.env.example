ADDR=:8080
REDIS_URL=redis://localhost:6379/0
# Optional Postgres/Supabase archive for bottles (leave empty to disable)
# DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:5432/postgres
POOL_TTL_HOURS=24
BOTTLE_TTL_HOURS=168
MAX_POOL_KEYS=10000
MAX_ACTIVE_BOTTLES=500
# Optional: protects GET /api/metrics (send as X-Metrics-Token header).
# Leave empty for open access (local dev only — set it in production).
# METRICS_TOKEN=change-me
